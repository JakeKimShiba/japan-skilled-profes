# Copy to .env.local and fill in to enable GA4 tracking in production builds.
# Example: VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=# Example environment configuration
# Copy this file to .env or .env.production and modify as needed

# Base URL for deployment
# For GitHub Pages with repository name, use: /repository-name/
# For custom domain or default deployment, use: /
VITE_BASE_URL=/

# Application name (used in meta tags)
VITE_APP_NAME=Japan Visa Calculator

# Version number
VITE_APP_VERSION=1.0.0

# Additional build options
# NODE_ENV=production